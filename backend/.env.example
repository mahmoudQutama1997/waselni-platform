# Local development values only. Use a unique generated SECRET_KEY in production.
SECRET_KEY=replace-this-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://localhost,capacitor://localhost
# Extra regexes (comma-separated) added to the built-in preview deployment allow-list
CORS_ALLOWED_ORIGIN_REGEXES=
CSRF_TRUSTED_ORIGINS=https://localhost,capacitor://localhost
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0
DATABASE_URL=
# Optional Redis for cross-process WebSocket delivery; falls back to in-memory.
# Use REDIS_URL directly, or REDIS_HOST/REDIS_PORT (as on Render Key Value).
REDIS_URL=
REDIS_HOST=
REDIS_PORT=6379
# Serve /media/ through Django when no web server or object storage does it
SERVE_MEDIA=True
# Optional persistent media directory (for example /var/data/media on a Render disk)
# Render's default filesystem is ephemeral: without a mounted disk the folder is
# wiped on every deploy, so every persistent upload should use ImageKit.
MEDIA_ROOT=

# Optional ImageKit storage for public images and captain documents. Leave all
# values empty to keep every upload on local disk. IMAGEKIT_PRIVATE_KEY is a
# server secret: set it in the hosting dashboard, never commit it or ship it to
# the frontend.
# Server-side uploads read only IMAGEKIT_PRIVATE_KEY and IMAGEKIT_URL_ENDPOINT;
# IMAGEKIT_PUBLIC_KEY is optional and only needed for in-browser uploads.
# Captain documents are uploaded as private ImageKit files and are only readable
# through short-lived signed URLs generated by the backend.
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=
IMAGEKIT_UPLOAD_FOLDER_PREFIX=waselni

# Temporary estimated ride pricing in ILS; configure before production
RIDE_BASE_FARE=5.00
RIDE_PRICE_PER_KM=2.00
RIDE_CHECKPOINT_FEE=15.00

# Optional one-time initial administrator bootstrap (keep real values out of Git).
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Local development only; required by `python manage.py seed_demo` when DEBUG=True.
WASELNI_DEMO_PASSWORD=
